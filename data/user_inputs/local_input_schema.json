{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GramVyapar Local Input",
  "description": "Canonical entrepreneur input accepted by the future prototype.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "location_id",
    "business_id",
    "available_capital"
  ],
  "properties": {
    "location_id": {
      "type": "string",
      "minLength": 1
    },
    "business_id": {
      "type": "string",
      "minLength": 1
    },
    "available_capital": {
      "type": "number",
      "minimum": 0
    },
    "known_competitors": {
      "type": "integer",
      "minimum": 0
    },
    "local_price": {
      "type": "number",
      "minimum": 0
    },
    "monthly_rent": {
      "type": "number",
      "minimum": 0
    },
    "supplier_distance": {
      "type": "number",
      "minimum": 0
    },
    "existing_experience": {
      "type": "string"
    }
  }
}
