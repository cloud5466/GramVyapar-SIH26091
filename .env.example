# Local development only. Omit this variable on Vercel so the browser uses
# same-origin /api routes on the deployed GramVyapar domain.
NEXT_PUBLIC_GRAMVYAPAR_API_URL=http://localhost:8000

# Optional grounded advisory layer. Analysis remains fully functional when disabled.
GRAMVYAPAR_AI_ENABLED=false
GRAMVYAPAR_LLM_PROVIDER=openai
GRAMVYAPAR_LLM_MODEL=gpt-5.4-mini
GRAMVYAPAR_AI_TIMEOUT_SECONDS=12
OPENAI_API_KEY=
